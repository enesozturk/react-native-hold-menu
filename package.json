{
  "name": "react-native-hold-menu",
  "version": "1.0.0",
  "description": "A lean, modern hold-to-open context menu for React Native powered by Reanimated 4.",
  "packageManager": "pnpm@10.30.1",
  "main": "lib/commonjs/index.js",
  "module": "lib/module/index.js",
  "types": "lib/typescript/index.d.ts",
  "react-native": "src/index.ts",
  "files": [
    "src",
    "lib",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__"
  ],
  "keywords": [
    "react-native",
    "ios",
    "android",
    "hold-menu",
    "context-menu",
    "hold-to-open",
    "reanimated",
    "menu"
  ],
  "repository": "https://github.com/enesozturk/react-native-hold-menu",
  "author": "Enes Ozturk (https://ozturkenes.com)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/enesozturk/react-native-hold-menu/issues"
  },
  "homepage": "https://enesozturk.github.io/react-native-hold-menu",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .js,.ts,.tsx",
    "clean": "rimraf lib",
    "build": "pnpm clean && bob build",
    "example": "pnpm --dir example start",
    "docs": "pnpm --dir website start",
    "docs:build": "pnpm --dir website build"
  },
  "peerDependencies": {
    "expo-blur": "*",
    "expo-haptics": "*",
    "react": ">=19.2.0",
    "react-native": ">=0.83.0",
    "react-native-gesture-handler": ">=2.0.0",
    "react-native-reanimated": ">=4.2.0",
    "react-native-worklets": ">=0.7.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@types/react": "^19.2.14",
    "@typescript-eslint/eslint-plugin": "^8.56.1",
    "@typescript-eslint/parser": "^8.56.1",
    "eslint": "^8.57.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "expo-blur": "*",
    "expo-haptics": "*",
    "prettier": "^3.8.1",
    "react": "^19.2.4",
    "react-native": "0.83.0",
    "react-native-builder-bob": "^0.40.18",
    "react-native-gesture-handler": "^2.30.0",
    "react-native-reanimated": "^4.2.2",
    "react-native-worklets": "^0.7.4",
    "rimraf": "^6.1.3",
    "typescript": "^5.9.3"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "commonjs",
      "module",
      "typescript"
    ]
  }
}
